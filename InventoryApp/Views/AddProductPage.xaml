<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="InventoryApp.Views.AddProductPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Inventory App"
    BackgroundColor="{StaticResource MyBackgroundColor}"
    Shell.NavBarIsVisible="True">

    <!--  Header  -->
    <Shell.TitleView>
        <Grid Padding="0,0,8,0" ColumnDefinitions="*">
            <Label
                Grid.Column="0"
                FontAttributes="Bold"
                FontSize="20"
                LineBreakMode="TailTruncation"
                Text="Inventory App - New product"
                VerticalOptions="Center" />
        </Grid>
    </Shell.TitleView>

    <ScrollView>
        <VerticalStackLayout Padding="8" Spacing="8">

            <!--  Product information  -->
            <Border
                Padding="16"
                BackgroundColor="{StaticResource MyCardBackgroundColor}"
                Stroke="{StaticResource MyBorderColor}"
                StrokeShape="RoundRectangle 16"
                StrokeThickness="1">
                <VerticalStackLayout Spacing="8">
                    <VerticalStackLayout Spacing="8">
                        <Label
                            FontSize="18"
                            Text="Name"
                            TextColor="{StaticResource MyLightLabelColor}" />
                        <Border
                            Padding="8,0"
                            BackgroundColor="{StaticResource MyInputBackgroundColor}"
                            Stroke="{StaticResource MyBorderColor}"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="1">
                            <Entry
                                FontSize="18"
                                Keyboard="Text"
                                Text="{Binding Name, Mode=TwoWay}" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Barcode" TextColor="{StaticResource MyLightLabelColor}" />
                        <Border
                            Padding="8,0"
                            BackgroundColor="{StaticResource MyInputBackgroundColor}"
                            Stroke="{StaticResource MyBorderColor}"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="1">
                            <Entry Keyboard="Text" Text="{Binding Barcode, Mode=TwoWay}" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Price" TextColor="{StaticResource MyLightLabelColor}" />
                        <Border
                            Padding="8,0"
                            BackgroundColor="{StaticResource MyInputBackgroundColor}"
                            Stroke="{StaticResource MyBorderColor}"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="1">
                            <Entry Keyboard="Numeric" Text="{Binding Price, Mode=TwoWay, StringFormat='{0}'}" />
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Quantity" TextColor="{StaticResource MyLightLabelColor}" />
                        <Border
                            Padding="8,0"
                            BackgroundColor="{StaticResource MyInputBackgroundColor}"
                            Stroke="{StaticResource MyBorderColor}"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="1">
                            <Entry Keyboard="Numeric" Text="{Binding Quantity, Mode=TwoWay}" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!--  Save action  -->
            <VerticalStackLayout Padding="16" Spacing="8">
                <Button
                    BackgroundColor="{StaticResource MySaveButtonBackgroundColor}"
                    Command="{Binding SaveProduct}"
                    CornerRadius="10"
                    Text="Save" />
                <Label Text="{Binding ProductValidation}" TextColor="{StaticResource MyWarningColor}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>